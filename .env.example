# =============================================================================
# llm-speed-benchmark — пример конфигурации
#
# Скопируйте в .env (в рабочей директории) или в ~/.llm-speed-benchmark.env:
#   cp .env.example .env
#
# Приоритет (сверху вниз):
#   1. Аргументы командной строки  (bench_multi -u ... -m ...)
#   2. Переменные окружения
#   3. Файл .env
#
# Загрузка: utils.py -> load_dotenv() из cwd + ~/.llm-speed-benchmark.env
# =============================================================================


# -----------------------------------------------------------------------------
# Базовая конфигурация
# Используется: bench_single, bench_multi, bench_vision, bench_audio
# -----------------------------------------------------------------------------

# Адрес LLM-сервера (OpenAI-compatible API: vLLM, Ollama, LiteLLM, SGLang, ...)
BASE_URL=http://localhost:8000/v1

# API-ключ (vLLM не проверяет, можно любой; для прокси/шлюзов — реальный)
API_KEY=sk-vllm-qwen3.5-0.8b

# Название модели (как на сервере)
MODEL=qwen3.5-0.8b

# Лимит контекста в токенах (85% — триггер обрезки истории в bench_single/multi)
MAX_CONTEXT_TOKENS=262144


# -----------------------------------------------------------------------------
# bench_multi — таймаут запроса к модели
# -----------------------------------------------------------------------------

# Таймаут запроса к модели в секундах (read-таймаут httpx: ожидание первого
# чанка во время prefill + паузы между чанками).
# 0 = без таймаута (ждать бесконечно) — нужно для медленных серверов с долгим
# prefill длинных промптов (например long context: 100K токенов при ~12 tok/s).
# По умолчанию 600. Переопределяется CLI: bench_multi --model-timeout 0
MULTI_MODEL_TIMEOUT=600


# -----------------------------------------------------------------------------
# bench_transcription — ASR (Whisper, Qwen-ASR)  [endpoint: audio.transcriptions]
# -----------------------------------------------------------------------------
# Приоритет: CLI > TRANSCRIPTION_* > базовые BASE_URL/API_KEY/MODEL

TRANSCRIPTION_BASE_URL=http://192.168.45.10:30070/v1
TRANSCRIPTION_API_KEY=any_key
TRANSCRIPTION_MODEL=Qwen3-ASR-0.6B

# Таймаут запроса к модели в секундах (долгие аудио). По умолчанию 600.
TRANSCRIPTION_MODEL_TIMEOUT=1200


# -----------------------------------------------------------------------------
# bench_tts — синтез речи (Qwen3-TTS и др.)  [endpoint: audio.speech]
# -----------------------------------------------------------------------------
# Приоритет: CLI > TTS_* > базовые BASE_URL/API_KEY/MODEL

TTS_BASE_URL=http://192.168.45.10:30080/v1
TTS_API_KEY=any_key
TTS_MODEL=Qwen3-TTS-12Hz-0.6B-Base

# Таймаут запроса к модели в секундах. По умолчанию 600.
TTS_MODEL_TIMEOUT=600


# -----------------------------------------------------------------------------
# bench_emb — эмбединги (embeddinggemma-300m и др.)  [endpoint: embeddings]
# -----------------------------------------------------------------------------
# Приоритет: CLI > EMB_* > базовые BASE_URL/API_KEY/MODEL

EMB_BASE_URL=http://192.168.45.10:30004/v1
EMB_API_KEY=any_key
EMB_MODEL=/mnt/extendet_data/models_emb/embeddinggemma-300m

# Таймаут запроса к модели в секундах. По умолчанию 600.
EMB_MODEL_TIMEOUT=600