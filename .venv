#!/usr/bin/env bash
# Активирует виртуальное окружение llm-speed-benchmark
#
# ИСПОЛЬЗОВАНИЕ:
#   source .venv      (или . .venv)
# НЕ запускать как:  ./venv  — это создаст подпроцесс, окружение сразу исчезнет!

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Ошибка: запускай через source:  source .venv"
    exit 1
fi

source /home/hermes/workspace/venvs/llm-speed-benchmark/venv/bin/activate
